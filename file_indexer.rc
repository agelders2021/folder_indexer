            VALUE "OriginalFilename", "file_indexer.exe"
            VALUE "ProductName",      "File Indexer"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04B0
    END
END
